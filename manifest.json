{
  "manifest_version": 2,
  "name": "Web Time Tracker",
  "version": "0.0.1",
  "description": "Track time spent on different domains",
  
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "webNavigation",
    "idle",
    "<all_urls>"
  ],
  
  "background": {
    "scripts": ["src/background/background.ts"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "css": ["src/content/styles/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_title": "Web Time Tracker",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  
  "icons": {
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  
  "content_security_policy": "script-src 'self'; object-src 'self'",
  
  "homepage_url": "https://github.com/JayDosunmu/web-time-tracker",
  
  "applications": {
    "gecko": {
      "id": "web-time-tracker@extension.local",
      "strict_min_version": "109.0"
    }
  }
}
