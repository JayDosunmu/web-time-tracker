{
  "name": "web-time-tracker",
  "version": "1.0.0",
  "description": "Firefox extension to track time spent on different domains",
  "main": "dist/background.js",
  "scripts": {
    "build:dev": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "dev": "vite build --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"types/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"types/**/*.ts\" --fix",
    "clean": "rimraf build dist",
    "package": "npm run build:prod && web-ext build --source-dir dist"
  },
  "dependencies": {
    "preact": "^10.28.3",
    "react-icons": "^5.5.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/sinon-chrome": "^2.2.16",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0",
    "sinon-chrome": "^3.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vite-plugin-web-extension": "^4.5.0",
    "web-ext": "^8.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/*.test.{ts,tsx}"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@types/(.*)$": "<rootDir>/types/$1",
      "^preact$": "<rootDir>/node_modules/preact/dist/preact.js",
      "^preact/hooks$": "<rootDir>/node_modules/preact/hooks/dist/hooks.js",
      "^preact/jsx-runtime$": "<rootDir>/node_modules/preact/jsx-runtime/dist/jsxRuntime.js",
      "^preact/compat$": "<rootDir>/node_modules/preact/compat/dist/compat.js",
      "^preact/test-utils$": "<rootDir>/node_modules/preact/test-utils/dist/testUtils.js",
      "^react$": "<rootDir>/node_modules/preact/compat/dist/compat.js",
      "^react-dom$": "<rootDir>/node_modules/preact/compat/dist/compat.js",
      "^react-dom/test-utils$": "<rootDir>/node_modules/preact/test-utils/dist/testUtils.js",
      "^react/jsx-runtime$": "<rootDir>/node_modules/preact/jsx-runtime/dist/jsxRuntime.js",
      "\\.css\\?inline$": "<rootDir>/tests/css-inline-mock.js"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "env": {
      "browser": true,
      "es2020": true,
      "webextensions": true
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "@typescript-eslint/no-explicit-any": "error"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayDosunmu/web-time-tracker.git"
  },
  "keywords": [
    "firefox",
    "extension",
    "time-tracking",
    "productivity",
    "typescript"
  ],
  "author": "Taslim Dosunmu",
  "license": "MIT"
}
